APP_ENV=development

# development = a LAN/dev IP | production = 127.0.0.1
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=your_db_user
DB_PASS=your_db_pass
DB_NAME=movira_core_dev

# agentra's own schema (holds app_user, auth_sso_jti, policies, customers, …)
CORE_SCHEMA=agentra_dev
APP_SCHEMA=agentra_dev

# movira_core schema — where log_request lives (shared with movira_api)
MOVIRA_CORE_SCHEMA=movira_core_dev

# app_role.app_role_id assigned to self-registered users (must exist: SELECT * FROM app_role)
DEFAULT_REGISTER_ROLE=app_role69f45cfb90d05

# IMPORTANT: generate with `openssl rand -hex 32` (≥ 64 hex chars / 32 bytes).
# Never commit a real secret here — this file is tracked in git.
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# ── Movira SSO (consumer) ────────────────────────────────────────────────────
# Path to Movira Core's SSO public key (RS256). Required for /api/v1/auth/sso.
MOVIRA_SSO_PUBLIC_KEY_PATH=/path/to/sso_public.pem
# Issuer claim in the assertion. Default: movira-core
MOVIRA_SSO_ISSUER=movira-core

# ── WhatsApp HTTP API (WAHA) ─────────────────────────────────────────────────
WAHA_BASE_URL=https://waha.example.com
WAHA_SESSION=your_waha_session
WAHA_API_KEY=CHANGE_ME

# ── Object storage (Cloudeka S3) — document uploads ─────────────────────────
# Same bucket as xlab-backend / erpAPI v2. Keys are prefixed agentra/ (production)
# or agentra-dev/ (everything else), so apps sharing the bucket never collide.
S3_ENDPOINT=https://kencana.basic.box.cloudeka.id
S3_REGION=kencana
S3_BUCKET=your_bucket
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# SumoPod payment gateway (subscription checkout). API key: SumoPod dashboard -> Quick Start -> API Keys.
# Webhook URL to register there: https://<host>/api/v1/subscription/webhook (its signing secret goes below).
SUMOPOD_BASE_URL=https://api-pay.sumopod.com
SUMOPOD_API_KEY=
SUMOPOD_WEBHOOK_SECRET=
SUMOPOD_SUCCESS_URL=
SUMOPOD_CANCEL_URL=
